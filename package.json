{
  "name": "smartify-product-catalog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build-catalog": "node scripts/build-catalog.mjs",
    "check-catalog": "node scripts/build-catalog.mjs --check",
    "verify-catalog": "node scripts/verify-catalog.mjs",
    "catalogue:test": "node --test catalogue/test/*.test.mjs",
    "catalogue:build": "node catalogue/scripts/build.mjs",
    "catalogue:bundle": "wrangler deploy --dry-run --config catalogue/wrangler.jsonc"
  },
  "devDependencies": {
    "miniflare": "5.20261019.2-beta",
    "pdfjs-dist": "6.4.299",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
